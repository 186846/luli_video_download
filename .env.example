# 复制为项目根目录 .env 后填写（勿提交真实密钥）

# AI（可选；空则 Mock）
# SPEEDYDL_AI_API_KEY=
# SPEEDYDL_AI_BASE_URL=https://api.deepseek.com/v1
# SPEEDYDL_AI_MODEL=deepseek-chat
# SPEEDYDL_AI_REQUIRE_VIP=1

# 账号 / VIP
# SPEEDYDL_DB_PATH=data/speedydl.db
# SPEEDYDL_ALLOW_DEMO_VIP=0

# Stripe Test mode
SPEEDYDL_STRIPE_SECRET_KEY=sk_test_替换为你的密钥
SPEEDYDL_STRIPE_WEBHOOK_SECRET=whsec_本地CLI输出的密钥
# 可选：Dashboard 里创建的 Price ID；留空则用代码内 $9.90 USD price_data
# SPEEDYDL_STRIPE_PRICE_ID=price_xxx
SPEEDYDL_PUBLIC_BASE_URL=http://127.0.0.1:5173
SPEEDYDL_API_PUBLIC_BASE_URL=http://127.0.0.1:8001
